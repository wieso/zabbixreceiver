        "uid": "victoriametrics"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (receiver, le) (rate(otelcol_receiver_zabbix_values_duration_bucket{job=\"otelcol-zabbix\",receiver=~\"$receiver\"}[$__rate_interval])))",
          "legendFormat": "{{receiver}} values",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (receiver, le) (rate(otelcol_receiver_zabbix_discover_duration_bucket{job=\"otelcol-zabbix\",receiver=~\"$receiver\"}[$__rate_interval])))",
          "legendFormat": "{{receiver}} discover",
          "datasource": {
